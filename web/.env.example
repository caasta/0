# Puerto HTTP (cPanel suele inyectar PORT automáticamente)
PORT=3000

# Escucha en todas las interfaces (necesario en cPanel / Passenger)
HOST=0.0.0.0

# Contraseña inicial del admin si aún no existe data/auth.json
# Si data/auth.json ya existe, esta variable NO la sobrescribe.
ADMIN_PASSWORD=admin123

NODE_ENV=production
